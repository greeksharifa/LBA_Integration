@@ -0,0 +1,194 @@
+import torch
+# from .dramaqa import DramaQA
+from .base_dataset import BaseDataset
+import json
+import os
+import glob
+import random
+
+
+class SubQA_DramaQA(BaseDataset):
+    def __init__(self, args=None, tokenizer=None, split='train'):
+        super().__init__(args, tokenizer, split)
+        self.data = self._get_data(split)
+        self.features = torch.load(f'./data/dramaqa/clipvitl14.pth')
+        self.split = split
+        self.answer_mapping = {0: '0', 1: '1', 2: '2', 3: '3', 4: '4'}
+        self.num_options = 5
+        print(f"Num {split} data: {len(self.data)}")
+        print(f"Num features: {len(self.features)}, type: {type(self.features)}")
+        # print(self.features.keys())
+        json.dump(list(self.features.keys()), open(f'subqa_dramaqa_features_{split}_key.json', 'w'))
+        self._cnt = 0
+    
+        
+    def _get_data(self, split):
+        data_path = f'./data/dramaqa/AnotherMissOhQA_{split}_set.json'
+        json_data = json.load(open(data_path, "r"))
+        if split == "train":
+            scene_anns = []
+            shot_qas = {}
+            for ann in json_data:
+                vid = ann["vid"]
+                if vid.endswith("0000"):  # scene
+                    scene_anns.append(ann.copy())
+                else:   # shot
+                    key = vid[:-4] + "0000" # ex. AnotherMissOh14_001_0000
+                    if key not in shot_qas:
+                        shot_qas[key] = []
+                    shot_qas[key].append((
+                        ann["que"],
+                        ann["answers"][ann["correct_idx"]]
+                    ))
+
+            result = []
+            for scene_ann in scene_anns:
+                sample = scene_ann.copy()
+                vid = scene_ann["vid"]
+                if vid in shot_qas:
+                    sample["sub_qa_list"] = shot_qas[vid]
+                    result.append(sample)
+            
+            from pprint import pprint
+            # pprint(result[0])
+            return result
+
+        else:
+            return json_data
+
+    def __getitem__(self, idx):
+        vid = self.data[idx]['vid']
+        qtype = -1
+
+        if 'sub_qa_list' in self.data[idx]: # scene
+            sub_qa_list = self.data[idx]['sub_qa_list']
+            # sub_q, sub_a = random.choice(sub_qa_list) #['sub_qa']
+            # answer = f"related_question: {sub_q}\nanswer: {sub_a}\nAnswer: The answer is {self.data[idx]['correct_idx']}"
+            sub_N = min(len(sub_qa_list), 4)
+            samples = random.sample(sub_qa_list, sub_N)
+            for sample in samples:
+                sub_q, sub_a = sample
+                answer = f"related_question: {sub_q}\nanswer: {sub_a}\n"
+                
+            answer += f"Answer: The answer is {self.data[idx]['correct_idx']}"
+        else: # shot
+            answer = f"Answer: The answer is {self.data[idx]['correct_idx']}"
+        
+        if self._cnt < 3: 
+            self._cnt += 1
+            print('getitem answer:', answer)
+
+        text = self._get_text(idx)
+        text_id, label, video_start, video_index, label_mask = self._get_text_token(text, answer)
+        video, video_len, scene = self._get_video(f'{vid}', idx)
+
+        q_level_logic = self.data[idx]['q_level_logic']
+
+        return {"vid": vid, "video": video, "video_len": video_len, "text": text, "text_id": text_id, "label": label, "video_start": video_start,
+                "video_index": video_index, "label_mask": label_mask, "qid": idx, "answer": answer, "qtype": qtype, 
+                "q_level_logic": q_level_logic}
+
+
+    def _get_text(self, idx):
+        if self.split == "train":
+            question = self.data[idx]["que"].capitalize().strip()
+            if question[-1] != "?":
+                question = str(question) + "?"
+
+            inst_text = "You are a professional assistant. \
+Given a video, step by step, you generate a related question and answer. And, answer the Question.\n"
+
+            # print('*' * 200, '\n', 'sub_qa:', sub_q, sub_a)
+            options = self.data[idx]['answers']
+
+            q_text = f"Question: {question}\n"
+
+            o_text = "Choices: \n"
+            for i in range(self.num_options):
+                o_text += f"{self.answer_mapping[i]} {options[i]}\n"
+            
+            text = {'q_text': inst_text + q_text, 'o_text': o_text, 'a_text': ''}
+            return text
+    #         question = self.data[idx]["que"].capitalize().strip()
+    #         if question[-1] != "?":
+    #             question = str(question) + "?"
+
+    #         inst_text = "You are a professional assistant. \
+    # A video and a related question and answer are provided. You must answer the last question.\n"
+
+    #         sub_qa_list = self.data[idx]['sub_qa_list']
+    #         sub_q, sub_a = random.choice(sub_qa_list) #['sub_qa']
+    #         # print('*' * 200, '\n', 'sub_qa:', sub_q, sub_a)
+    #         options = self.data[idx]['answers']
+
+    #         sub_text = f"Question: {sub_q}\nAnswer: {sub_a}\n"
+    #         q_text = f"Question: {question}\n"
+
+    #         o_text = "Choices: \n"
+    #         for i in range(self.num_options):
+    #             o_text += f"{self.answer_mapping[i]} {options[i]}\n"
+
+    #         a_text = "Answer: The answer is " # "Answer: " #
+            
+    #         text = {'q_text': inst_text + sub_text + q_text, 'o_text': o_text, 'a_text': a_text}
+    #         return text
+
+        else:
+            question = self.data[idx]["que"].capitalize().strip()
+            if question[-1] != "?":
+                question = str(question) + "?"
+
+            options = self.data[idx]['answers']
+
+            q_text = f"Question: {question}\n"
+            o_text = "Choices: \n"
+            for i in range(self.num_options):
+                o_text += f"{self.answer_mapping[i]} {options[i]}\n"
+            a_text = "Answer: The answer is "
+
+            text = {'q_text': q_text, 'o_text': o_text, 'a_text': a_text, 'options': options}
+            return text
+
+    def _get_video(self, video_id , idx):
+        
+        scene = True
+        # Scene
+        if video_id[-4:] == '0000':
+            shots = self.data[idx]['shot_contained']
+            start, end = shots[0], shots[1]
+
+            for i in range(start, end+1):
+                v_name = video_id[:-4] + f'{i:04}'
+
+                if v_name not in self.features.keys(): 
+                    print(v_name, " Not in features")
+                    nxt_vid = torch.zeros(1, self.features_dim)
+                else: nxt_vid = self.features[v_name].float()
+
+                if i == start: video = nxt_vid
+                else: video = torch.concat((video, nxt_vid), dim = 0)
+        # Shot
+        else:
+            scene = False
+            if video_id not in self.features.keys():
+                print(video_id, "Not in freatures")
+                video = torch.zeros(1, self.features_dim)
+            else:
+                video = self.features[video_id].float()
+
+        if len(video) > self.max_feats:
+            sampled = []
+            for j in range(self.max_feats):
+                sampled.append(video[(j * len(video)) // self.max_feats])
+            video = torch.stack(sampled)
+            video_len = self.max_feats
+        elif len(video) < self.max_feats:
+            video_len = len(video)
+            video = torch.cat([video, torch.zeros(self.max_feats - video_len, self.features_dim)], 0)
+        else:
+            video_len = self.max_feats
+
+        return video, video_len, scene
+
+    def __len__(self):
+        return len(self.data)
