+import os
+import json
+import glob
+from pprint import pprint
+
+from collections import Counter
+
+# result = ['# Questions', '# Q lv 1', '# Q lv 2', '# Q lv 3', '# Q lv 4', '# Shot Q', '# Scene Q']
+#           '# Q lv 1', '# Q lv 2', '# Q lv 3', '# Q lv 4' 'Total'
+# # Shot Q |
+# # Scene Q|
+# # Total  |
+
+for split in ['train', 'val', 'test']:
+    result = [[0 for _ in range(5)] for _ in range(3)]
+    json_data = json.load(open(f'/data1/AnotherMissOh/AnotherMissOhQA_{split}_set.json', 'r'))
+    for sample in json_data:
+        qtype = len(sample["shot_contained"])
+        lv = sample["q_level_logic"]
+        result[qtype-1][lv-1] += 1
+    
+    for j in range(4):
+        result[2][j] = result[0][j] + result[1][j]
+    for i in range(3):
+        result[i][4] = sum(result[i][:4])
+    
+    print(split)
+    for i in range(3):
+        for j in range(5):
+            print(f'{result[i][j]:8}', end='')
+        print()
+
+counter = Counter()
+# walks = os.walk('/data1/AnotherMissOh/images/')
+# print(walks)
+
+for (root, dirs, files) in os.walk('/data1/AnotherMissOh/images/'):
+
+    for i, dir in enumerate(dirs):
+        # if i> 0:
+            # break
+        print(dir)
+        cnt = len(dir)
+        if cnt == 15:
+            counter["Episode"] += 1
+        elif cnt == 3:
+            counter["Scene"] += 1
+        elif cnt == 4:
+            counter["Shot"] += 1
+
+print(counter)
