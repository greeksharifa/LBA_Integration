@@ -0,0 +1,113 @@
+import torch
+from .base_dataset import BaseDataset
+import json
+import random
+
+"""
+train
+>>> pprint(data['265814016'])
+{'image_id': 265814,
+ 'introspect': [{'pred_q_type': 'reasoning',
+                 'sub_qa': [{'sub_answer': 'yes',
+                             'sub_question': 'are there two sets of windows?'}]},
+                {'pred_q_type': 'reasoning',
+                 'sub_qa': [{'sub_answer': 'yes',
+                             'sub_question': 'is the bus a double decker?'}]},
+                {'pred_q_type': 'perception',
+                 'sub_qa': [{'sub_answer': 'two',
+                             'sub_question': 'how many decks does the bus have?'}]}],
+ 'reasoning_answer_most_common': 'yes',
+ 'reasoning_question': 'is this a double decker bus?'}
+
+ val
+ >>> pprint(data['565248001'])
+{'image_id': 565248,
+ 'introspect': [{'pred_q_type': 'perception',
+                 'sub_qa': [{'sub_answer': 'yea',
+                             'sub_question': 'are the woman on the horses near to the sea?'}]},
+                {'pred_q_type': 'reasoning',
+                 'sub_qa': [{'sub_answer': 'yes',
+                             'sub_question': 'is there sand and whitewater?'}]},
+                {'pred_q_type': 'perception',
+                 'sub_qa': [{'sub_answer': 'yea',
+                             'sub_question': 'are the woman on the horses near to the sea?'}]},
+                {'pred_q_type': 'reasoning',
+                 'sub_qa': [{'sub_answer': 'yes',
+                             'sub_question': 'is there sand and whitewater?'}]}],
+ 'reasoning_answer_most_common': 'yes',
+ 'reasoning_question': 'are they at the beach?'}
+"""
+class VQA_Introspect(BaseDataset):
+    def __init__(self, args=None, tokenizer=None, split='train'):
+        super().__init__(args, tokenizer, split)
+        data = json.load(open(f'./data/vqaintrospect/VQAIntrospect_{split}v1.0.json', "r"))
+        self.data = []
+        for key, value in data.items():
+            sample = value.copy()
+            sample['q_id'] = key
+            self.data.append(sample)
+        self.features = torch.load(f'./data/vqaintrospect/CLIPViT_L14/clipvitl14.pth')
+        self.answer_mapping = {0: '(A)', 1: '(B)', 2: '(C)', 3: '(D)', 4: '(E)'}
+        self.num_options = 5
+
+        print(f"Num {split} data: {len(self.data)}")
+        print(f"Num features: {len(self.features)}, type: {type(self.features)}")
+        print(self.features.keys())
+        json.dump(list(self.features.keys()), open(f'data/features_key/vqaintrospect_features_{split}_key.json', 'w')) # TODO
+        
+    def _get_text(self, idx):
+        question = self.data[idx]["reasoning_question"].capitalize().strip()
+        if question[-1] != "?":
+            question = str(question) + "?"
+
+        inst_text = "You are a professional assistant. \
+A video and related questions and answers are provided. You must answer the last question.\n"
+
+        sub_qa_list = self.data[idx]['introspect']
+        sub_qa = random.choice(sub_qa_list)['sub_qa'][0]
+        # print('*' * 200, '\n', 'sub_qa:', sub_qa)
+        sub_q = sub_qa['sub_question']
+        sub_a = sub_qa['sub_answer']
+
+        sub_text = f"Question: {sub_q}\nAnswer: {sub_a}\n"
+        q_text = f"Question: {question}\n"
+        a_text = "Answer: " #"Answer: The answer is "
+
+        # text = {'q_text': q_text, 'o_text': o_text, 'a_text': a_text, 'options': options}
+        text = {'q_text': '', 'o_text': '', 'a_text': inst_text + q_text + a_text}
+
+        return text
+
+    def _get_video(self, video_id):
+        if video_id not in self.features.keys():
+            print(video_id, "Not in features")
+            video = torch.zeros(1, self.features_dim)
+        else:
+            video = self.features[video_id].float()
+        
+        if len(video) > self.max_feats:
+            sampled = []
+            for j in range(self.max_feats):
+                sampled.append(video[(j * len(video)) // self.max_feats])
+            video = torch.stack(sampled)
+            video_len = self.max_feats
+        elif len(video) < self.max_feats:
+            video_len = len(video)
+            video = torch.cat([video, torch.zeros(self.max_feats - video_len, self.features_dim)], 0)
+        else:
+            video_len = self.max_feats
+
+        return video, video_len
+
+    def __getitem__(self, idx):
+        vid = self.data[idx]['image_id']
+        qtype = -1
+        answer = self.data[idx]['reasoning_answer_most_common']
+        text = self._get_text(idx)
+        text_id, label, video_start, video_index, label_mask = self._get_text_token(text, answer)
+        video, video_len = self._get_video(f'{vid}', idx)
+        return {"vid": vid, "video": video, "video_len": video_len, "text": text, "text_id": text_id, "label": label, "video_start": video_start,
+                "video_index": video_index, "label_mask": label_mask, "qid": idx, "answer": answer, "qtype": qtype}
+
+    def __len__(self):
+        return len(self.data)
